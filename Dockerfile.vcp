# Dockerfile.vcp
FROM tesla/vehicle-command:latest

WORKDIR /app
RUN mkdir -p /config

# Aja proxy ja syötä yksityinen avain ympäristömuuttujasta
# HUOM: älä commitoi avainta repoosi
CMD ["/bin/sh", "-lc", "\
  echo \"$TESLA_PRIVATE_KEY_PEM\" > /config/fleet-key.pem && \
  /vehicle-command \
    -host 0.0.0.0 \
    -port 10000 \
    -key-file /config/fleet-key.pem \
    -log-level info \
"]
