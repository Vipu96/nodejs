# Dockerfile.vcp
FROM tesla/vehicle-command:latest

# Render hoitaa TLS-terminoinnin portin yläpuolella, joten ajetaan HTTP:llä.
# Syötetään yksityinen avain envistä tiedostoon ja käynnistetään proxy portissa 10000.
CMD ["/bin/sh", "-lc", "\
  mkdir -p /data && \
  printf \"%s\" \"$TESLA_PRIVATE_KEY_PEM\" > /data/fleet-key.pem && \
  /vehicle-command \
    -host 0.0.0.0 \
    -port 10000 \
    -key-file /data/fleet-key.pem \
    -log-level info \
"]
