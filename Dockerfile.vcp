# Dockerfile.vcp — ajaa teslamotors/vehicle-command -proxyn Renderissä
FROM teslamotors/vehicle-command:latest

# Render hoitaa TLS-terminoinnin → ajetaan kontissa HTTP:llä portissa 10000.
# Luetaan yksityinen avain salaisesta env-muuttujasta ja kirj. tiedostoon.
CMD ["/bin/sh", "-lc", "\
  mkdir -p /data && \
  printf \"%s\" \"$TESLA_PRIVATE_KEY_PEM\" > /data/fleet-key.pem && \
  /vehicle-command \
    -host 0.0.0.0 \
    -port 10000 \
    -key-file /data/fleet-key.pem \
    -log-level info \
"]
